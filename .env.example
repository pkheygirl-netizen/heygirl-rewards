# Copy to `.env` and fill in real values. `.env` is gitignored: never commit secrets.
# In production these are set as Railway variables on BOTH services (web and
# worker), not from a file. See README.md for the full runbook.

# --- Shopify ---
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_client_secret
SHOPIFY_APP_URL=https://app.heygirl.pk
SCOPES=read_customers,write_customers,read_orders,read_discounts,write_discounts,read_products,write_products,read_content,write_content
# No shop domain variable is needed any more (SHOPIFY_SHOP_DOMAIN and
# SHOP_DOMAIN were removed). The shop comes from the signed webhook / app proxy
# request, and background jobs read it from the stored install session.

# Public store address, used only for the "see your rewards" button in emails.
# Optional: without it the emails are sent with no button.
STOREFRONT_URL=https://www.your-store.com

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# --- Redis (BullMQ queues/workers) ---
REDIS_URL=redis://default:password@host:6379

# --- Email (SMTP) ---
# Without SMTP_HOST no email is sent (the app keeps working).
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="HeyGirl Rewards <rewards@your-domain.com>"

# --- WhatsApp (optional) ---
# Nothing is sent unless WhatsApp is switched on in the app's settings AND both
# of these are set. Requires a WhatsApp Business Platform account with
# approved message templates (see README).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Runtime ---
# WORKER=1 on the worker service only: it runs the queues and scheduled jobs
# instead of serving web requests. Leave it unset on the web service.
# NODE_ENV is set by the platform.
