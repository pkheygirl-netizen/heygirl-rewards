{%- comment -%}
  HeyGirl Rewards: app embed (target body).
  Prints the launcher and a small JSON config, then loads one deferred script.
  Settings come from the app-data metafield written by the admin on save.
  Renders nothing only when the config is missing (not yet published). The
  program switch does not hide anything: it only pauses redeeming (contract
  rule 20, `redeemPaused`).
  The toast (nudges) follows the panel style: hg-core.js adds hg-toast--dark
  unless the style is Light; its colours are the Dark panel tokens.
  The cart line's CSS is printed once per page: by the product or cart app
  block when present, otherwise by hg-core.js (never twice).
  Guests cause no request to the app server.
{%- endcomment -%}
{%- assign cfg = app.metafields.hg_loyalty.config.value -%}
{%- if cfg -%}
  <style>
    .hg-launcher{position:fixed;z-index:2147483000;bottom:20px;{{ block.settings.position }}:16px;display:inline-flex;align-items:center;gap:9px;height:48px;min-height:48px;padding:0 20px 0 16px;border:1px solid #c99a12;border-radius:999px;background:#0e0e0e;color:#f3bd1c;font:inherit;font-size:15px;font-weight:600;line-height:1;letter-spacing:.2px;text-transform:none;white-space:nowrap;cursor:pointer;box-shadow:0 6px 18px rgba(0,0,0,.25)}
    .hg-launcher:focus-visible{outline:3px solid #f3bd1c;outline-offset:2px;box-shadow:0 0 0 7px #0e0e0e,0 6px 18px rgba(0,0,0,.25)}
    .hg-launcher[aria-busy=true]{opacity:.8}
    .hg-launcher .hg-ico{width:22px;height:22px;flex:none;color:#f3bd1c}
    .hg-launcher__label{display:inline-block;min-width:84px;text-align:left;white-space:nowrap}
    .hg-toast{position:fixed;z-index:2147482999;bottom:84px;{{ block.settings.position }}:16px;width:300px;max-width:calc(100vw - 32px);padding:14px 44px 14px 14px;border:1px solid #e9e2cc;border-radius:14px;background:#fff;color:#1a1a1a;font-size:14px;line-height:1.4;letter-spacing:normal;box-shadow:0 8px 28px rgba(0,0,0,.18)}
    .hg-toast p{margin:0}
    .hg-toast__t{font-weight:700;font-size:15px}
    .hg-toast__b{color:#595959;margin-top:2px!important}
    .hg-toast__x{position:absolute;top:0;right:0;width:44px;height:44px;border:0;background:none;color:#1a1a1a;font-size:22px;line-height:1;cursor:pointer}
    .hg-toast--dark{border-color:#3a3a3a;border-top:2px solid #f3bd1c;background:#121212;color:#f5f5f5;box-shadow:0 8px 28px rgba(0,0,0,.6)}
    .hg-toast--dark .hg-toast__b{color:#bdbdbd}
    .hg-toast--dark .hg-toast__x{color:#f5f5f5}
    .hg-toast--dark :focus-visible{outline:3px solid #f5f5f5;outline-offset:2px;box-shadow:none}
    .hg-toast__cta{display:inline-flex;align-items:center;min-height:44px;margin-top:8px;padding:0 16px;border:2px solid #7a5c00;border-radius:999px;background:#e8ad00;color:#1a1a1a;font:inherit;font-weight:700;text-decoration:none;cursor:pointer}
    @media (prefers-reduced-motion:no-preference){.hg-launcher{transition:transform .15s ease}.hg-launcher:hover{transform:translateY(-2px)}}
    @media print{.hg-launcher,.hg-toast{display:none}}
  </style>
  {%- comment -%} Line gift (stroke = currentColor): gold on the black launcher, dark gold on the cart/product lines. {%- endcomment -%}
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><symbol id="hg-i-gift" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="8.5" width="17" height="4" rx="1"/><path d="M5 12.5v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7"/><path d="M12 8.5v12"/><path d="M12 8.5c-1.2-2.6-4.8-3.6-5.6-1.6-.6 1.5 1.6 1.6 5.6 1.6zM12 8.5c1.2-2.6 4.8-3.6 5.6-1.6.6 1.5-1.6 1.6-5.6 1.6z"/></symbol></svg>
  <button
    type="button"
    id="hg-launcher"
    class="hg-launcher"
    data-hg-open=""
    data-pos="{{ block.settings.position }}"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label="{{ cfg.launcherLabel | default: 'Shop & Earn' | escape }}: open {{ cfg.programName | escape }}"
  >
    <svg class="hg-ico" aria-hidden="true" focusable="false"><use href="#hg-i-gift"/></svg>
    {%- comment -%} Visitors: the On-site text (plain text, escaped). Members: hg-core.js writes the balance. {%- endcomment -%}
    <span class="hg-launcher__label">{{ cfg.launcherLabel | default: 'Shop & Earn' | escape }}</span>
  </button>
  {%- liquid
    assign hg_rewards_url = block.settings.rewards_page.url | default: routes.account_login_url
  -%}
  <script type="application/json" id="hg-loyalty-data">
    {
      "config": {
        "enabled": true,
        "redeemPaused": {% if cfg.redeemPaused == true %}true{% else %}false{% endif %},
        "panelTheme": {% if cfg.panelTheme == 'light' %}"light"{% else %}"dark"{% endif %},
        "programName": {{ cfg.programName | json }},
        "tagline": {{ cfg.tagline | json }},
        "pointsRate": {{ cfg.pointsRate | default: 0 | json }},
        "signupPoints": {{ cfg.signupPoints | default: 0 | json }},
        "referralPoints": {{ cfg.referralPoints | default: 0 | json }},
        "reviewPoints": {{ cfg.reviewPoints | default: 0 | json }},
        "social": {{ cfg.social | json }},
        "earnRules": {{ cfg.earnRules | json }},
        "tiers": {{ cfg.tiers | json }},
        "redemptionTiers": {{ cfg.redemptionTiers | json }},
        "birthday": {{ cfg.birthday | json }},
        "nudges": {{ cfg.nudges | json }},
        "campaign": {{ cfg.campaign | json }},
        "nextCampaign": {{ cfg.nextCampaign | json }},
        "expiryDays": {{ cfg.expiryDays | default: 0 | json }},
        "friendFreeShipping": {{ cfg.friendFreeShipping | json }},
        "tierRewards": {{ cfg.tierRewards | json }}
      },
      "customer": {% if customer %}{ "id": {{ customer.id | append: '' | json }} }{% else %}null{% endif %},
      "page": {{ request.page_type | json }},
      "urls": {
        "login": {{ routes.account_login_url | json }},
        "hub": {{ 'hg-hub.js' | asset_url | json }},
        "rewards": {{ hg_rewards_url | json }},
        "shop": {{ routes.all_products_collection_url | json }}
      },
      "cart": {
        "total": {{ cart.total_price | default: 0 | json }},
        "count": {{ cart.item_count | default: 0 | json }},
        "codes": [{% for d in cart.discount_applications %}{% if d.type == 'discount_code' %}{{ d.title | json }},{% endif %}{% endfor %}null]
      }
    }
  </script>
  <script src="{{ 'hg-core.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Rewards launcher",
  "target": "body",
  "settings": [
    {
      "type": "select",
      "id": "position",
      "label": "Launcher position",
      "options": [
        { "value": "right", "label": "Bottom right" },
        { "value": "left", "label": "Bottom left" }
      ],
      "default": "right"
    },
    {
      "type": "page",
      "id": "rewards_page",
      "label": "Rewards page",
      "info": "Opened if the rewards panel cannot load."
    }
  ]
}
{% endschema %}
